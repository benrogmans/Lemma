{
  "name": "lemma-language",
  "displayName": "Lemma Language",
  "description": "Language support for Lemma: syntax highlighting, inline diagnostics, and clickable Registry references",
  "version": "0.8.16",
  "publisher": "lemma",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemma/lemma"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lemma"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lemma",
        "aliases": [
          "Lemma",
          "lemma"
        ],
        "extensions": [
          ".lemma"
        ],
        "filenames": [
          "lemma.std"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lemma",
        "scopeName": "source.lemma",
        "path": "./syntaxes/lemma.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "controlKeyword",
        "superType": "keyword",
        "description": "Control flow keywords (unless, then, uses, and, not, in, veto, …)"
      },
      {
        "id": "dataBody",
        "superType": "type",
        "description": "Data or with field body after the colon (type, value, constraints)"
      },
      {
        "id": "punctuation",
        "superType": "operator",
        "description": "Declaration colons separating field/rule names from their bodies"
      },
      {
        "id": "reference",
        "superType": "variable",
        "description": "Identifiers referenced in rule and spec bodies"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lemma",
        "scopes": {
          "namespace": ["keyword.other.namespace.lemma"],
          "class": ["storage.type.class.lemma"],
          "property": ["entity.name.tag.lemma"],
          "function": ["entity.name.function.preprocessor.lemma"],
          "string": ["string.quoted.double.lemma"],
          "comment": ["comment.block.lemma"],
          "keyword": ["storage.modifier.lemma"],
          "operator": ["keyword.operator.lemma"],
          "controlKeyword": ["keyword.control.lemma"],
          "dataBody": ["string.unquoted.lemma"],
          "punctuation": ["punctuation.definition.tag.lemma"],
          "reference": ["support.type.property-name.lemma"]
        }
      }
    ],
    "configuration": {
      "title": "Lemma",
      "properties": {
        "lemma.lspServerPath": {
          "type": "string",
          "default": "lsp",
          "description": "Path to the lsp binary. If not absolute, the binary is looked up on $PATH."
        }
      }
    },
    "configurationDefaults": {
      "[lemma]": {
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.defaultFormatter": "lemma.lemma-language",
        "editor.semanticTokenColorCustomizations": {
          "rules": {
            "namespace":      "#BD8EBB",
            "class":          "#5DBDAA",
            "property":       "#A3B5DF",
            "function":       "#A3B5DF",
            "string":         "#D07868",
            "comment":        "#595945",
            "keyword":        "#6BA0C2",
            "operator":       "#80807A",
            "controlKeyword": "#726B83",
            "dataBody":       "#D07868",
            "punctuation":    "#79987F",
            "reference":      "#A59582"
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "precommit": "npm ci && npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.9.1"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}
