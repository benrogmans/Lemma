doc coffee_order
"""
Coffee Shop Pricing

A simple example showing how facts and rules work together.
Perfect for understanding the basics of Lemma.
"""

fact type             = [text]
fact size             = [text]
fact number_of_cups   = [number]
fact has_loyalty_card = [boolean]

rule validated_type
  = veto "Unknown type of coffee"
  unless type is "espresso"   then type
  unless type is "latte"      then type
  unless type is "cappuccino" then type
  unless type is "mocha"      then type

rule validated_size 
  = veto "Unknown size of coffee"
  unless size is "small"  then size
  unless size is "medium" then size
  unless size is "large"  then size

rule base_price 
  = 0
  unless validated_type? is "espresso"   then 2.50
  unless validated_type? is "latte"      then 3.50
  unless validated_type? is "cappuccino" then 3.50
  unless validated_type? is "mocha"      then 4.00

rule size_multiplier 
  = 100%
  unless validated_size? is "small"  then  80%
  unless validated_size? is "medium" then 100%
  unless validated_size? is "large"  then 120%

rule price_per_cup 
  = base_price? * size_multiplier?

rule loyalty_discount 
  = 0%
  unless has_loyalty_card then 10%

rule total 
  = number_of_cups * price_per_cup? - loyalty_discount?

